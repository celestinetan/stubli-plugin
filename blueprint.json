{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Stubli demo",
    "author": "celestinetan",
    "description": "A demo Stubli in your browser: Ana's page, journal and guest book, her made-up friends, and the app. Everyone in it is made up, and it runs only in your browser."
  },
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "login"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Ana Keller",
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/celestinetan/stubli-plugin",
        "ref": "HEAD",
        "path": "/"
      },
      "options": {
        "activate": true,
        "targetFolderName": "stubli"
      }
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/stubli-demo"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/stubli-demo/setup.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/celestinetan/stubli-plugin/demo/setup.php"
      }
    },
