{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Stubli demo",
    "author": "celestinetan",
    "description": "A demo Stubli in your browser: Ana's page, journal, guest book and app. Everyone in it is made up. Nothing is saved."
  },
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "login"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Ana Keller",
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/celestinetan/stubli-plugin",
        "ref": "HEAD",
        "path": "/"
      },
      "options": {
        "activate": true,
        "targetFolderName": "stubli"
      }
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/stubli-demo"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/stubli-demo/setup.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/celestinetan/stubli-plugin/demo/setup.php"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/stubli-demo/tram-rain.jpg",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/celestinetan/stubli-plugin/demo/tram-rain.jpg"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/stubli-demo/coffee.jpg",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/celestinetan/stubli-plugin/demo/coffee.jpg"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/stubli-demo/lake-dawn.jpg",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/celestinetan/stubli-plugin/demo/lake-dawn.jpg"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/stubli-demo/old-town.jpg",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/celestinetan/stubli-plugin/demo/old-town.jpg"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/stubli-demo/peaks.jpg",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/celestinetan/stubli-plugin/demo/peaks.jpg"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/stubli-demo/food.jpg",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/celestinetan/stubli-plugin/demo/food.jpg"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/stubli-demo/forest-fog.jpg",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/celestinetan/stubli-plugin/demo/forest-fog.jpg"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/stubli-demo/city-night.jpg",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/celestinetan/stubli-plugin/demo/city-night.jpg"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-content/stubli-demo/setup.php';"
    }
  ]
}